<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TWApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             x:DataType="vm:AboutPageViewModel"
             x:Class="TWApp.Views.AboutPageView">

          <Viewbox Stretch="Uniform">

            <RelativePanel
              Width="800"
              Height="450">

              <Button
                Name="BackButton"
                Width="120"
                Height="30"
                Content="&#x2190; Назад"
                RenderTransform="scale(0.8)" 
                RenderTransformOrigin="0%,0%" 
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignTopWithPanel="True"
                Margin="15, 15, 15, 15"
                Command="{Binding ToHomePageCommand}">
              </Button>
              
              <md:MarkdownScrollViewer 
                Name="TextABout"
                Margin="16" 
                RenderTransform="scale(0.8)" 
                RenderTransformOrigin="0%,0%" 
                Source="avares://TWApp/Assets/AboutProject.md"
                RelativePanel.AlignHorizontalCenterWithPanel="True"
                RelativePanel.Below="BackButton">
                
              </md:MarkdownScrollViewer>
              
            </RelativePanel>

          </Viewbox>
</UserControl>
