<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TWApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:LessonsErrorPageViewModel"
             x:Class="TWApp.Views.LessonsErrorPageView"
             >
  <Viewbox Stretch="Uniform">

    <RelativePanel
      Width="800"
      Height="600">

      <TextBlock
        Name="ErrorText"
        Width="400"
        Height="100"
        RelativePanel.AlignHorizontalCenterWithPanel="True"
        RelativePanel.AlignTopWithPanel="True"
        RenderTransform="scale(0.8)" 
        RenderTransformOrigin="0%,0%" 
        Text="{Binding Error, StringFormat={}{0} Логи ошибки:}"
        Margin="15, 15, 15, 15"
        >
      </TextBlock>

      <ScrollViewer
        Name="Logs"
        Width="600"
        Height="300"
        RelativePanel.AlignHorizontalCenterWithPanel="True"
        RelativePanel.Below="ErrorText"
        RenderTransform="scale(0.8)" 
        RenderTransformOrigin="0%,0%" 
        Content="{Binding Logs}"
        Margin="10, 10, 10, 10">
      </ScrollViewer>

      <Button
        Name="FromErrorToMenuButton"
        Width="200"
        Height="50"
        RelativePanel.AlignHorizontalCenterWithPanel="True"
        RelativePanel.Below="Logs"
        RenderTransform="scale(0.8)" 
        RenderTransformOrigin="0%,0%" 
        Content="Назад в меню"
        Margin="10, 10, 10, 10"
        Command="{Binding OpeHomePageCommand}">
      </Button>

    </RelativePanel>

  </Viewbox>
</UserControl>
